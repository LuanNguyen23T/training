<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds">

    <!-- Import Spring Boot default conversion rules for colors & exceptions -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml" />

    <!-- Application Properties -->
    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="employee-management" />
    <property name="LOG_DIR" value="logs" />
    <property name="LOG_FILE" value="${LOG_DIR}/application.log" />

    <!-- Console Logging Pattern with ANSI Colors -->
    <property name="CONSOLE_LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %clr(%-5level) %clr([%15.15t]){faint} %clr(%-40.40logger{39}){cyan} %clr(:){faint} %msg%n%wEx" />

    <!-- File Logging Pattern (clean text, no ANSI escape sequences) -->
    <property name="FILE_LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %-40.40logger{39} : %msg%n%wEx" />

    <!-- Console Appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Rolling File Appender with daily rotation and size limit -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_FILE}</file>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/archived/application-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- Development Profile: DEBUG detail, Console + File appenders -->
    <springProfile name="dev">
        <logger name="com.sun.training.employeemanagement" level="DEBUG" />
        <logger name="org.springframework.web" level="INFO" />
        <logger name="org.hibernate.SQL" level="DEBUG" />
        <root level="INFO">
            <appender-ref ref="CONSOLE" />
            <appender-ref ref="FILE" />
        </root>
    </springProfile>

    <!-- Production Profile: INFO/WARN levels, Console + File appenders -->
    <springProfile name="prod">
        <logger name="com.sun.training.employeemanagement" level="INFO" />
        <logger name="org.springframework.web" level="WARN" />
        <logger name="org.hibernate.SQL" level="ERROR" />
        <root level="WARN">
            <appender-ref ref="CONSOLE" />
            <appender-ref ref="FILE" />
        </root>
    </springProfile>

    <!-- Fallback / Test Profile when neither dev nor prod is active -->
    <springProfile name="!dev &amp; !prod">
        <logger name="com.sun.training.employeemanagement" level="INFO" />
        <root level="INFO">
            <appender-ref ref="CONSOLE" />
        </root>
    </springProfile>

</configuration>

